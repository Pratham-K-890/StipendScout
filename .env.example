# Neon Postgres connection string (include ?sslmode=require)
DATABASE_URL=postgresql+psycopg://user:password@ep-xxxx.neon.tech/stipendscout?sslmode=require

# LLM provider (used for resume/cover-letter generation only — filtering
# and project ranking use free local embeddings, no API needed)
OPENROUTER_API_KEY=

# Job source APIs
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# GitHub personal access token (needs "repo" scope to see private repos too)
GITHUB_TOKEN=

# Comma-separated origins allowed to call this API. Leave commented out for
# local dev (defaults to localhost:5173/127.0.0.1:5173). Once you deploy
# the frontend, uncomment and add its real URL — an empty/unset var here
# falls back to the default, but a var present-and-empty does NOT, so don't
# uncomment this without filling it in:
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://your-frontend.vercel.app
